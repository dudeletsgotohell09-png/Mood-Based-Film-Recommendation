<Window x:Class="MoodFlick.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Sign In"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Grid>
        <Border Background="White" CornerRadius="14" Margin="30"
                Padding="36" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="24" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🎬" FontSize="52" HorizontalAlignment="Center"/>
                <TextBlock Text="MoodFlick" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDk}" HorizontalAlignment="Center"
                           Margin="0,6,0,2"/>
                <TextBlock Text="Mood-Based Film Recommendations" FontSize="13"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtUsername"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="TxtPassword"/>
                    <TextBox x:Name="TxtPasswordReveal" Visibility="Collapsed"/>
                </Grid>
                <CheckBox x:Name="ChkShowPassword" Content="Show Password" Margin="0,6,0,0"
                          Checked="ChkShowPassword_Checked" Unchecked="ChkShowPassword_Unchecked"
                          FontSize="11" Foreground="{StaticResource Muted}"/>

                <Button Content="Sign In" Style="{StaticResource BtnPrimary}"
                        Margin="0,24,0,0" Height="40" Click="SignIn_Click"
                        IsDefault="True"/>

                <Button Content="Create New Account" Style="{StaticResource BtnSecondary}"
                        Margin="0,10,0,0" Height="40" Click="SignUp_Click"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource Danger}"
                           FontSize="12" TextAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
