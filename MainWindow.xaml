<Window x:Class="MoodFlick.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Mood-Based Film Recommendation"
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,24">
                    <TextBlock Text="🎬 MoodFlick" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtTagline" Text="Film Recommendation System" FontSize="11"
                               Foreground="#0EA5E9" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- User panel at bottom -->
                <Border DockPanel.Dock="Bottom" Background="#0DFFFFFF" CornerRadius="8"
                        Margin="16,10,16,16" Padding="14,12" Cursor="Hand" MouseDown="UserPanel_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtUserName" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtUserRole" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Logout" Width="58" Height="26"
                                FontSize="11" Click="Logout_Click"
                                Background="#1AFFFFFF" Foreground="White" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Nav buttons -->
                <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" Margin="0,4,0,0"/>
            </DockPanel>
        </Border>

        <!-- ===== Content area ===== -->
        <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="0"/>
    </Grid>
</Window>
