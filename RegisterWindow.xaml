<Window x:Class="MoodFlick.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Sign Up"
        Height="580" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Grid>
        <Border Background="White" CornerRadius="14" Margin="30"
                Padding="36" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="24" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🎬" FontSize="52" HorizontalAlignment="Center"/>
                <TextBlock Text="Create Account" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDk}" HorizontalAlignment="Center"
                           Margin="0,6,0,2"/>
                <TextBlock Text="Join MoodFlick to discover films" FontSize="13"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtUsername"/>

                <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtFullName"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="TxtPassword"/>
                    <TextBox x:Name="TxtPasswordReveal" Visibility="Collapsed"/>
                </Grid>

                <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="TxtConfirmPassword"/>
                    <TextBox x:Name="TxtConfirmPasswordReveal" Visibility="Collapsed"/>
                </Grid>
                
                <CheckBox x:Name="ChkShowPassword" Content="Show Passwords" Margin="0,6,0,0"
                          Checked="ChkShowPassword_Checked" Unchecked="ChkShowPassword_Unchecked"
                          FontSize="11" Foreground="{StaticResource Muted}"/>

                <Button Content="Register" Style="{StaticResource BtnPrimary}"
                        Margin="0,24,0,0" Height="40" Click="Register_Click"
                        IsDefault="True"/>

                <Button Content="Back to Sign In" Style="{StaticResource BtnSecondary}"
                        Margin="0,10,0,0" Height="40" Click="BackToLogin_Click"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource Danger}"
                           FontSize="12" TextAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
