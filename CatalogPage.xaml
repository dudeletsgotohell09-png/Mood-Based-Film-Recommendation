<UserControl x:Class="MoodFlick.Views.Pages.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="📂 Film Catalog" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
                <TextBlock Text="Browse, search, and manage the full film database collection."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Search and Filters Panel -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="SEARCH TITLE / DIRECTOR / CAST" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- Genre Filter -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="GENRE" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CboGenre" Width="110" Height="30" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Action"/>
                            <ComboBoxItem Content="Comedy"/>
                            <ComboBoxItem Content="Romantic"/>
                            <ComboBoxItem Content="Horror"/>
                            <ComboBoxItem Content="Thriller"/>
                            <ComboBoxItem Content="Sci-Fi"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Language Filter -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="LANGUAGE" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CboLanguage" Width="110" Height="30" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Sinhala"/>
                            <ComboBoxItem Content="Tamil"/>
                            <ComboBoxItem Content="Korean"/>
                            <ComboBoxItem Content="Hindi"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Era Filter -->
                    <StackPanel Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ERA" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CboEra" Width="120" Height="30" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="2010s-Present"/>
                            <ComboBoxItem Content="2000s"/>
                            <ComboBoxItem Content="90's"/>
                            <ComboBoxItem Content="80's"/>
                            <ComboBoxItem Content="Before 80's"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <Button x:Name="BtnAddFilm" Grid.Column="1" Content="➕ Add New Film" 
                        Style="{StaticResource BtnPrimary}" Height="30" Padding="16,0"
                        Click="AddFilm_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="White" ClipToBounds="True">
            <DataGrid x:Name="GridFilms" Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INDEX" Binding="{Binding FilmId}" Width="60"/>
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="YEAR" Binding="{Binding Year}" Width="80"/>
                    <DataGridTextColumn Header="RATING" Binding="{Binding Rating}" Width="80"/>
                    <DataGridTextColumn Header="MOOD (POP QUIZ Q1)" Binding="{Binding MoodsDisplay}" Width="2*"/>
                    <DataGridTextColumn Header="GENRE (POP QUIZ Q2)" Binding="{Binding Genre}" Width="1.5*"/>
                    <DataGridTextColumn Header="LANGUAGE (POP QUIZ Q3)" Binding="{Binding Language}" Width="1.5*"/>
                    <DataGridTextColumn Header="ERA (POP QUIZ Q4)" Binding="{Binding Era}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Admin Edit/Delete Actions -->
        <StackPanel x:Name="AdminActionsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Visibility="Collapsed">
            <Button Content="✏️ Edit Selected Film" Style="{StaticResource BtnSecondary}" Height="38" Margin="0,0,12,0" Padding="16,0" Click="EditFilm_Click"/>
            <Button Content="🗑️ Delete Selected Film" Style="{StaticResource BtnDanger}" Height="38" Padding="16,0" Click="DeleteFilm_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
