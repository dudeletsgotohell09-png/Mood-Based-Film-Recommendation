<UserControl x:Class="MoodFlick.Views.Pages.ActivityLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🛡️ Activity Logs" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
                <TextBlock Text="Monitor user sessions, profile updates, recommendation history, and administrative actions."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Filters Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="SEARCH BY DETAILS, ACTION OR USER" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtSearch" Width="300" Height="30" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Content="🔄 Refresh Logs" Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" Margin="0,12,0,0" Click="Refresh_Click" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="White" ClipToBounds="True">
            <DataGrid x:Name="GridLogs" Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding created_at, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="160"/>
                    <DataGridTextColumn Header="USERNAME" Binding="{Binding username}" Width="100"/>
                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding full_name}" Width="150"/>
                    <DataGridTextColumn Header="ACTION" Binding="{Binding action}" Width="150"/>
                    <DataGridTextColumn Header="DETAILS" Binding="{Binding details}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
