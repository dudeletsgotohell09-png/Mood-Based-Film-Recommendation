<UserControl x:Class="MoodFlick.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="👥 User Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
                <TextBlock Text="Manage user credentials, roles, and administrative password resets."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" Content="➕ Add New User" Style="{StaticResource BtnPrimary}"
                    Height="36" Padding="16,0" Click="AddUser_Click" VerticalAlignment="Center"/>
        </Grid>

        <!-- Filters & Sorting Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="SEARCH USERNAME / NAME" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="FilterChanged"/>
                </StackPanel>

                <!-- Role Filter -->
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CboRole" Width="120" Height="30" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="user"/>
                    </ComboBox>
                </StackPanel>

                <!-- Sort By -->
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SORT BY" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CboSort" Width="140" Height="30" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Name (A-Z)" IsSelected="True"/>
                        <ComboBoxItem Content="Name (Z-A)"/>
                        <ComboBoxItem Content="Username"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="White" ClipToBounds="True">
            <DataGrid x:Name="GridUsers" Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="CREATED DATE" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="150"/>
                    <DataGridTemplateColumn Header="ACTIONS" Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Button Content="✏️ Edit" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                            Background="White" BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" Cursor="Hand"
                                            Click="EditUser_Click"/>
                                    <Button Content="🔑 Reset Password" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                            Background="White" BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" Cursor="Hand"
                                            Click="ResetPwd_Click" Tag="{Binding Username}"/>
                                    <Button Content="🗑️ Delete" FontSize="11" Padding="8,4"
                                            Style="{StaticResource BtnDanger}" Cursor="Hand"
                                            Click="DeleteUser_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
