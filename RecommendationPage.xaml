<UserControl x:Class="MoodFlick.Views.Pages.RecommendationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎯 Film Quiz Recommender" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
            <TextBlock Text="Complete the quick 4-question pop quiz to get priority-weighted recommendations."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ================= QUIZ GRID ================= -->
        <Grid x:Name="QuizGrid" Grid.Row="1" Visibility="Visible" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 2x2 Grid for the 4 Sections -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Section 1: Mood -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎭 Mood Vibe" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,10"/>
                        <TextBlock Text="1. How are you feeling right now? (Mood)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboMood" Height="38">
                            <ComboBoxItem Content="Happy" IsSelected="True"/>
                            <ComboBoxItem Content="Adventurous"/>
                            <ComboBoxItem Content="Romantic"/>
                            <ComboBoxItem Content="Sad"/>
                            <ComboBoxItem Content="Relaxed"/>
                            <ComboBoxItem Content="Tense"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section 2: Genre -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,12" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎬 Film Genre" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,10"/>
                        <TextBlock Text="2. What type of film are you in the mood for? (Genre)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboGenre" Height="38">
                            <ComboBoxItem Content="Action" IsSelected="True"/>
                            <ComboBoxItem Content="Comedy"/>
                            <ComboBoxItem Content="Romantic"/>
                            <ComboBoxItem Content="Horror"/>
                            <ComboBoxItem Content="Thriller"/>
                            <ComboBoxItem Content="Sci-Fi"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section 3: Language -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,12,0" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🗣️ Preferred Language" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,10"/>
                        <TextBlock Text="3. What language would you prefer?" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboLanguage" Height="38">
                            <ComboBoxItem Content="English" IsSelected="True"/>
                            <ComboBoxItem Content="Sinhala"/>
                            <ComboBoxItem Content="Tamil"/>
                            <ComboBoxItem Content="Korean"/>
                            <ComboBoxItem Content="Hindi"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section 4: Era -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,12,0,0" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⏳ Release Era" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,10"/>
                        <TextBlock Text="4. Do you prefer modern films or classics? (Film Era)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboEra" Height="38">
                            <ComboBoxItem Content="2010s-Present" IsSelected="True"/>
                            <ComboBoxItem Content="2000s"/>
                            <ComboBoxItem Content="90's"/>
                            <ComboBoxItem Content="80's"/>
                            <ComboBoxItem Content="Before 80's"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Submit Button centered at the bottom -->
            <Button Grid.Row="1" Content="🎯 Get Film Recommendations" Style="{StaticResource BtnPrimary}" 
                    Background="Pink" Foreground="Black"
                    Width="320" Height="46" Margin="0,20,0,10" HorizontalAlignment="Center" Click="SubmitQuiz_Click"/>
        </Grid>

        <!-- ================= RESULTS GRID ================= -->
        <Grid x:Name="ResultsGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Recommended Movies List -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtMatchHeader" Text="Top Matches for You" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDk}"/>
                        <TextBlock x:Name="TxtMatchPreferences" Text="Preferences selected: Mood, Genre, Language, Era" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Retake Quiz" Style="{StaticResource BtnSecondary}" Height="34" Click="RetakeQuiz_Click" Padding="12,0"/>
                </Grid>

                <ListBox x:Name="LstRecommendations" BorderThickness="0" Background="Transparent" SelectionChanged="LstRecommendations_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Width="480" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="{Binding YearGenreDisplay}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding LangRatingDisplay}" FontSize="12" Foreground="{StaticResource PrimaryDk}"/>
                                    </StackPanel>

                                    <!-- Score indicator in top right -->
                                    <Border Grid.Column="1" Background="{StaticResource Primary}" CornerRadius="12" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Match: " FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Score}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="/15" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: Selected Movie Detail Pane -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Background="White" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DetailsPane" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Movie Title -->
                            <TextBlock x:Name="TxtMovieTitle" Text="Inception" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,4"/>
                            
                            <!-- Genre & Year -->
                            <TextBlock x:Name="TxtMovieYearGenre" Text="2010 • Sci-Fi" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>

                            <!-- Rating & Language -->
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="⭐" FontSize="16" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtMovieRating" Text="8.8/10" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🗣️" FontSize="16" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtMovieLanguage" Text="English" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Director -->
                            <TextBlock Text="DIRECTOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtMovieDirector" Text="Christopher Nolan" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                            <!-- Cast -->
                            <TextBlock Text="CAST" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtMovieCast" Text="Leonardo DiCaprio, Joseph Gordon-Levitt" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Associated Moods -->
                            <TextBlock Text="ASSOCIATED MOODS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="PnlMovieMoods" Margin="0,0,0,16"/>

                            <!-- Description -->
                            <TextBlock Text="STORYLINE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMovieDescription" Text="A thief who steals corporate secrets..." FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
