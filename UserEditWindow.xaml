<Window x:Class="MoodFlick.Views.Pages.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Edit User"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Edit User Profile" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,16"/>

        <!-- Form fields Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtUsername" IsReadOnly="True" Background="#F1F5F9" Foreground="{StaticResource Muted}" BorderBrush="{StaticResource Border}" Margin="0,0,0,10"/>

                <TextBlock Text="FULL NAME *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtFullName" Margin="0,0,0,10"/>

                <TextBlock Text="ROLE *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboRole" Margin="0,0,0,10">
                    <ComboBoxItem Content="admin"/>
                    <ComboBoxItem Content="user"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtError" Grid.Column="0" Foreground="{StaticResource Danger}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource BtnSecondary}" Width="80" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource BtnPrimary}" Width="80" Height="34" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
