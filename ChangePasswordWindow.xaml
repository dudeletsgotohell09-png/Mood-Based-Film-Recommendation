<Window x:Class="MoodFlick.Views.Pages.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Change Password"
        Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Change Password" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,16"/>

        <!-- Form fields -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="CURRENT PASSWORD *" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,12">
                <PasswordBox x:Name="TxtCurrentPassword"/>
                <TextBox x:Name="TxtCurrentPasswordReveal" Visibility="Collapsed"/>
            </Grid>

            <TextBlock Text="NEW PASSWORD *" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,12">
                <PasswordBox x:Name="TxtNewPassword"/>
                <TextBox x:Name="TxtNewPasswordReveal" Visibility="Collapsed"/>
            </Grid>

            <TextBlock Text="CONFIRM NEW PASSWORD *" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,12">
                <PasswordBox x:Name="TxtConfirmNewPassword"/>
                <TextBox x:Name="TxtConfirmNewPasswordReveal" Visibility="Collapsed"/>
            </Grid>

            <CheckBox x:Name="ChkShowPassword" Content="Show Passwords" Margin="0,4,0,0"
                      Checked="ChkShowPassword_Checked" Unchecked="ChkShowPassword_Unchecked"
                      FontSize="11" Foreground="{StaticResource Muted}"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="TxtError" Grid.Column="0" Foreground="{StaticResource Danger}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource BtnSecondary}" Width="80" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Save" Style="{StaticResource BtnPrimary}" Width="80" Height="34" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
