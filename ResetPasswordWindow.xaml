<Window x:Class="MoodFlick.Views.Pages.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoodFlick — Reset Password"
        Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Reset User Password" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Target User: " Foreground="{StaticResource Muted}" FontSize="13"/>
                <TextBlock x:Name="TxtTargetUsername" Text="username" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- Form fields -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="NEW PASSWORD *" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtNewPassword" Margin="0,0,0,12"/>

            <TextBlock Text="CONFIRM NEW PASSWORD *" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtConfirmNewPassword" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="TxtError" Grid.Column="0" Foreground="{StaticResource Danger}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource BtnSecondary}" Width="80" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Reset" Style="{StaticResource BtnPrimary}" Width="80" Height="34" Click="Reset_Click"/>
        </Grid>
    </Grid>
</Window>
