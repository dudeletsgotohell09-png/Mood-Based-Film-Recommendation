<UserControl x:Class="MoodFlick.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock x:Name="TxtTitle" Text="Dashboard" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDk}"/>
            <TextBlock x:Name="TxtSubtitle" Text="Vibe overview and metrics"
                       Foreground="{StaticResource Muted}" Margin="0,2,0,24"/>

            <!-- Welcome Banner Card -->
            <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryDk}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWelcome" Text="Welcome back!" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Ready to find the perfect film matching your current vibe? Take a quick quiz or explore the catalog."
                                   FontSize="13" Foreground="#CCFBF1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🍿" FontSize="52" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <!-- Stat cards row -->
            <ItemsControl x:Name="StatsItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Main dashboard panel layout -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Mood Popularity Chart -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="🔥 Popular Moods" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryDk}"
                                   Margin="0,0,0,16"/>
                        <ItemsControl x:Name="MoodChartItems"/>
                    </StackPanel>
                </Border>

                <!-- Right Panel: Quick Actions -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚡ Quick Actions" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryDk}"
                                   Margin="0,0,0,16"/>
                        
                        <Button Content="🎯 Start Recommendation Quiz" Style="{StaticResource BtnPrimary}" 
                                Height="40" Margin="0,0,0,12" Click="StartQuiz_Click"/>
                        
                        <Button Content="📂 Browse Movie Catalog" Style="{StaticResource BtnSecondary}" 
                                Height="40" Margin="0,0,0,24" Click="BrowseCatalog_Click"/>

                        <TextBlock Text="ℹ️ About MoodFlick" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        <TextBlock Text="MoodFlick is a smart film recommender that ranks films using a priority-weighted match score (Mood &gt; Genre &gt; Language &gt; Era) to help eliminate choice overload." 
                                   FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
