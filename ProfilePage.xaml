<UserControl x:Class="MoodFlick.Views.Pages.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <!-- Header -->
            <TextBlock Text="👤 My Profile" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}"/>
            <TextBlock Text="View and update your personal details and change your password."
                       Foreground="{StaticResource Muted}" Margin="0,2,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Info Card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Personal Information" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,20"/>

                        <!-- Modern Initials Avatar -->
                        <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D9488" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="TxtAvatar" Text="U" FontSize="36" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Username and Role -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtUsername" IsEnabled="False" Background="#F1F5F9"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACCOUNT ROLE" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRole" IsEnabled="False" Background="#F1F5F9"/>
                            </StackPanel>
                        </Grid>

                        <!-- Full Name -->
                        <TextBlock Text="FULL NAME *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtFullName" Margin="0,0,0,16"/>

                        <!-- Member Since -->
                        <TextBlock Text="ACCOUNT CREATED AT" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCreated" IsEnabled="False" Background="#F1F5F9" Margin="0,0,0,24"/>

                        <!-- Error Text -->
                        <TextBlock x:Name="TxtError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Save Changes" Style="{StaticResource BtnPrimary}" Width="140" Height="38" Click="Save_Click"/>
                            <Button Content="🔑 Change Password" Style="{StaticResource BtnSecondary}" Width="150" Height="38" Margin="12,0,0,0" Click="ChangePassword_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Information Guide Card (Right) -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="24,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="📝 Vibe Preferences" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDk}" Margin="0,0,0,12"/>
                        <TextBlock Text="Your account details are used to log your Pop Quiz recommendations in the database, allowing MoodFlick to build statistics on popular vibes and active users."
                                   FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="12" BorderThickness="3,0,0,0" BorderBrush="{StaticResource Success}">
                            <TextBlock x:Name="TxtStatus" Text="Account is active and connected to MySQL database." FontSize="12" Foreground="#15803D" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
